#!/bin/bash
# taskChromePlugin pre-commit：
# 1) 暂存 lib/、popup/、background/、test/ 等时跑 node --test
# 2) 涉及登录链路（popup/background/lib/api|login|storage|async-timeout）时跑 Playwright E2E

set -u

cleanup() {
    echo "如果有测例失败，记得修复"
}
trap cleanup SIGINT SIGTERM EXIT

cd "$(dirname "$0")/../.." || exit 1

echo "Running pre-commit Node tests in $(pwd)..."

export PRE_COMMIT=1
STAGED_FILES="$(git diff --cached --name-only 2>/dev/null || true)"

should_run_all=false
should_run_login_e2e=false
while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
        lib/*|devtools/*|background/*|panel/*|popup/*|test/*|e2e/*|package.json)
            should_run_all=true
            ;;
    esac
    case "$f" in
        popup/*|background/*|lib/api.js|lib/storage.js|lib/async-timeout.js|lib/login-finalize.js|e2e/*)
            should_run_login_e2e=true
            ;;
    esac
done <<< "$STAGED_FILES"

while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
        test/*.test.js)
            echo "Running staged test: $f"
            node --test "$f" || exit 1
            ;;
    esac
done <<< "$STAGED_FILES"

if [ "$should_run_all" = true ]; then
    echo "Staged plugin source changed; running npm test..."
    npm test || exit 1
fi

if [ "$should_run_login_e2e" = true ]; then
    echo "Staged login-related files; running Popup token-login Playwright E2E..."
    export CI=1
    export PRE_COMMIT=1
    bash e2e/popup-token-login.playwright.test.js.sh || exit 1
fi

echo "taskChromePlugin pre-commit checks passed."
