{
  "manifest_version": 3,
  "name": "云端Coding: 自动创新助手",
  "version": "1.8.77",
  "description": "在云端自动增加功能，修改bug，指哪改哪",
  "default_locale": "zh_CN",
  "commands": {
    "toggle-element-picker": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Alt+X"
      },
      "description": "切换指针选择模式（选取页面元素加入任务描述）"
    },
    "page-optimization-suggest": {
      "suggested_key": {
        "default": "Alt+Z",
        "mac": "Alt+Z"
      },
      "description": "对当前页面生成优化建议并填入任务描述（多选，不自动创建）"
    },
    "page-optimization-suggest-region": {
      "suggested_key": {
        "default": "Alt+Shift+Z",
        "mac": "Alt+Shift+Z"
      },
      "description": "先点选页面元素，再对该元素生成优化建议（多选，不自动创建）"
    }
  },
  "permissions": [
    "storage",
    "webRequest",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "云端Coding: 自动创新助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "devtools_page": "devtools/devtools.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/content-boot-gate.js",
        "lib/i18n.js",
        "lib/i18n-messages.js",
        "lib/i18n-ui-messages.js",
        "lib/i18n-tx.js",
        "lib/storage.js",
        "lib/dom-trace.js",
        "lib/create-task-git-identity.js",
        "lib/branch-datalist.js",
        "lib/create-task-payload.js",
        "lib/element-picker.js",
        "lib/plugin-brand.js",
        "lib/float-workspace-select.js",
        "lib/workspace-list.js",
        "lib/workspace-members.js",
        "lib/float-members-ui.js",
        "lib/project-auto-run-label.js",
        "lib/workspace-auto-schedule.js",
        "lib/float-panel-markup.js",
        "lib/task-detail-href.js",
        "lib/float-panel-after-create.js",
        "lib/aidev-meta.js",
        "lib/hot-path-guards.js",
        "lib/visibility-interval.js",
        "lib/auth-refresh-debounce.js",
        "lib/page-context.js",
        "lib/page-advisor-region.js",
        "lib/page-advisor-a11y.js",
        "lib/page-advisor-fill.js",
        "lib/page-advisor-preview.js",
        "lib/page-advisor-defaults.js",
        "lib/page-advisor-card-layout.js",
        "lib/page-advisor-site-pending.js",
        "lib/float-last-selection.js",
        "lib/click-guard.js",
        "lib/is-auth-route.js",
        "lib/dialog-focus-trap.js",
        "content/float-boot.js",
        "content/float-pick.js",
        "content/float-drag-auth.js",
        "content/float-aidev.js",
        "content/float-form.js",
        "content/float-snapshot.js",
        "content/float-page-advisor-region.js",
        "content/float-page-advisor-layer.js",
        "content/float-page-advisor-drag.js",
        "content/float-page-advisor.js",
        "content/float-page-advisor-site-pending.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css",
        "content/content-form.css",
        "content/page-advisor.css",
        "content/content-region.css"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/content-boot-gate.js",
        "lib/element-picker.js",
        "content/pick-frame.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "oauth-callback.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
